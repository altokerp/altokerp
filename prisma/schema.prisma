generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PASSENGER
  DRIVER
}

enum ServiceType {
  AUTO
  MOTO
}

enum DriverStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum TripStatus {
  REQUESTED
  MATCHING
  ACCEPTED
  DRIVER_ARRIVING
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum PaymentMethod {
  CASH
  YAPE
  PLIN
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DocumentType {
  LICENSE
  SOAT
  VEHICLE_REGISTRATION
  DNI
  BACKGROUND_CHECK
}

enum DocumentStatus {
  UPLOADED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model User {
  id                String         @id @default(cuid())
  role              UserRole
  email             String?        @unique
  phone             String?        @unique
  passwordHash      String?
  googleId          String?        @unique
  firstName         String
  lastName          String
  profilePhotoUrl   String?
  emergencyContact  String?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  passengerTrips    Trip[]         @relation("PassengerTrips")
  givenRatings      Rating[]       @relation("GivenRatings")
  supportTickets    SupportTicket[]
  driverProfile     Driver?
}

model Driver {
  id                    String            @id @default(cuid())
  userId                String            @unique
  serviceType           ServiceType
  status                DriverStatus      @default(PENDING)
  isOnline              Boolean           @default(false)
  currentLat            Decimal?          @db.Decimal(9, 6)
  currentLng            Decimal?          @db.Decimal(9, 6)
  averageRating         Decimal?          @db.Decimal(2, 1)
  totalTrips            Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user                  User              @relation(fields: [userId], references: [id])
  vehicle               Vehicle?
  driverDocuments       DriverDocument[]
  trips                 Trip[]            @relation("DriverTrips")
  earnings              DriverEarning[]
}

model Vehicle {
  id                String       @id @default(cuid())
  driverId          String       @unique
  serviceType       ServiceType
  brand             String
  model             String
  color             String
  plate             String       @unique
  year              Int
  seatCount         Int?
  helmetCount       Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  driver            Driver       @relation(fields: [driverId], references: [id])
}

model DriverDocument {
  id                String          @id @default(cuid())
  driverId          String
  type              DocumentType
  fileUrl           String
  status            DocumentStatus  @default(UPLOADED)
  reviewedBy        String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime        @default(now())

  driver            Driver          @relation(fields: [driverId], references: [id])
}

model Trip {
  id                    String         @id @default(cuid())
  passengerId           String
  driverId              String?
  serviceType           ServiceType
  status                TripStatus     @default(REQUESTED)
  originAddress         String
  originLat             Decimal        @db.Decimal(9, 6)
  originLng             Decimal        @db.Decimal(9, 6)
  destinationAddress    String
  destinationLat        Decimal        @db.Decimal(9, 6)
  destinationLng        Decimal        @db.Decimal(9, 6)
  estimatedDistanceKm   Decimal        @db.Decimal(6, 2)
  estimatedDurationMin  Int
  estimatedFare         Decimal        @db.Decimal(10, 2)
  finalFare             Decimal?       @db.Decimal(10, 2)
  requestedAt           DateTime       @default(now())
  acceptedAt            DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  canceledAt            DateTime?

  passenger             User           @relation("PassengerTrips", fields: [passengerId], references: [id])
  driver                Driver?        @relation("DriverTrips", fields: [driverId], references: [id])
  payment               Payment?
  ratings               Rating[]
  promotionUsage        PromotionUsage?
}

model Payment {
  id                String         @id @default(cuid())
  tripId            String         @unique
  method            PaymentMethod
  status            PaymentStatus  @default(PENDING)
  subtotal          Decimal        @db.Decimal(10, 2)
  discount          Decimal        @default(0) @db.Decimal(10, 2)
  total             Decimal        @db.Decimal(10, 2)
  externalRef       String?
  paidAt            DateTime?
  createdAt         DateTime       @default(now())

  trip              Trip           @relation(fields: [tripId], references: [id])
}

model DriverEarning {
  id                String      @id @default(cuid())
  driverId          String
  tripId            String      @unique
  grossAmount       Decimal     @db.Decimal(10, 2)
  commissionAmount  Decimal     @db.Decimal(10, 2)
  netAmount         Decimal     @db.Decimal(10, 2)
  createdAt         DateTime    @default(now())

  driver            Driver      @relation(fields: [driverId], references: [id])
}

model Rating {
  id                String      @id @default(cuid())
  tripId            String
  reviewerId        String
  reviewedDriverId  String?
  score             Int
  comment           String?
  createdAt         DateTime    @default(now())

  trip              Trip        @relation(fields: [tripId], references: [id])
  reviewer          User        @relation("GivenRatings", fields: [reviewerId], references: [id])

  @@unique([tripId, reviewerId])
}

model Promotion {
  id                String          @id @default(cuid())
  code              String          @unique
  description       String
  serviceType       ServiceType?
  discountPercent   Decimal?        @db.Decimal(5, 2)
  discountFixed     Decimal?        @db.Decimal(10, 2)
  maxDiscount       Decimal?        @db.Decimal(10, 2)
  startsAt          DateTime
  endsAt            DateTime
  maxUses           Int?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())

  usages            PromotionUsage[]
}

model PromotionUsage {
  id                String      @id @default(cuid())
  promotionId       String
  tripId            String      @unique
  passengerId       String
  createdAt         DateTime    @default(now())

  promotion         Promotion   @relation(fields: [promotionId], references: [id])
  trip              Trip        @relation(fields: [tripId], references: [id])
}

model SupportTicket {
  id                String      @id @default(cuid())
  userId            String
  tripId            String?
  subject           String
  message           String
  priority          String      @default("MEDIUM")
  status            String      @default("OPEN")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user              User        @relation(fields: [userId], references: [id])
}

model CoverageZone {
  id                String      @id @default(cuid())
  name              String
  city              String      @default("Lima")
  isActive          Boolean     @default(true)
  polygonGeoJson    Json
  baseFareAuto      Decimal     @db.Decimal(10, 2)
  baseFareMoto      Decimal     @db.Decimal(10, 2)
  pricePerKmAuto    Decimal     @db.Decimal(10, 2)
  pricePerKmMoto    Decimal     @db.Decimal(10, 2)
  pricePerMinAuto   Decimal     @db.Decimal(10, 2)
  pricePerMinMoto   Decimal     @db.Decimal(10, 2)
  createdAt         DateTime    @default(now())
}
